# Server-only Store configuration. Never prefix these with NEXT_PUBLIC_.
STORE_ENABLED=false
ATLAS_API_URL=https://dashboard-preview.example.com
ATLAS_STOREFRONT_API_KEY=replace-with-a-long-environment-specific-secret
# Preview only when the Atlas deployment uses Vercel Authentication.
ATLAS_VERCEL_BYPASS_SECRET=replace-with-the-dashboard-automation-bypass-secret
AUTH_SECRET=replace-with-a-separate-long-environment-specific-secret

# This is the only public configuration value.
NEXT_PUBLIC_SITE_URL=https://store-preview.example.com
